# Database Configuration (SQLite default for 0-setup local runs; switchable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Authentication Security
JWT_SECRET="heritage-food-atlas-secure-production-jwt-key-replace-in-prod"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Integration (Optional: Gemini 1.5/2.0 API Key for live AI Vision & Grounded Storyteller)
# If left blank, the platform automatically utilizes its built-in Heritage Vector & Rule Matching Engine
GEMINI_API_KEY=""

# Environment
NODE_ENV="development"
